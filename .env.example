# ===== 卡站 .env =====
# 复制为 .env 并填实际值
# Discord OAuth2 应用：https://discord.com/developers/applications

# === 必填 ===

# 服务端口
PORT=3080

# Discord 应用的 client id / secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# OAuth 回调地址，必须和 Discord 应用里设的完全一致
DISCORD_REDIRECT_URI=http://localhost:3080/auth/discord/callback

# Express session secret，随机 32+ 字节字符串
# 生成：openssl rand -hex 32
SESSION_SECRET=

# 用户 API key 的 AES-256 加密密钥，必须 64 hex 字符（32 字节）
# ⚠️ 一旦设定不能变；变了就会让数据库里所有已加密的 key 失效
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=


# === 可选 ===

# Discord Guild + Role 鉴权（若不填则任何 Discord 用户都能登录）
DISCORD_GUILD_ID=
DISCORD_REQUIRED_ROLE_IDS=
# all=必须全部满足，any=只要满足一个
DISCORD_ROLE_MATCH=all

# 拉取 guild 成员需要的 Bot token（仅当 DISCORD_GUILD_ID 启用时需要）
DISCORD_BOT_TOKEN=

# 鉴权失败时返回给用户的提示
DISCORD_AUTH_FAIL_MESSAGE=请先加入指定服务器并完成身份组验证

# 角色卡尾部追加的 license 文本
CC_LICENSE=
